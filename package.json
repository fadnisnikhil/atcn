{
  "name": "atcn-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/schema",
    "packages/usage",
    "packages/core",
    "packages/verifiers",
    "packages/subledger",
    "packages/sdk-ts",
    "packages/atcn-sdk",
    "packages/adapter-a2a",
    "packages/verify-cli",
    "examples/local-runner",
    "examples/a2a-delegation",
    "examples/a2a-cost-gateway",
    "examples/x402-payments",
    "packages/mcp-server"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "atcn-local demo",
    "demo:a2a": "npm start -w examples/a2a-delegation",
    "demo:cost-gateway": "npm start -w examples/a2a-cost-gateway",
    "demo:x402": "npm start -w examples/x402-payments",
    "check:versions": "node scripts/release.mjs check",
    "set-version": "node scripts/release.mjs set",
    "release:plan": "node scripts/release.mjs plan",
    "gen:schemas": "tsx --conditions=atcn-source packages/schema/scripts/generate-json-schemas.ts && tsx --conditions=atcn-source packages/subledger/scripts/generate-json-schemas.ts",
    "gen:vectors": "tsx --conditions=atcn-source packages/schema/scripts/generate-test-vectors.ts && tsx --conditions=atcn-source packages/subledger/scripts/generate-test-vectors.ts && tsx --conditions=atcn-source packages/verifiers/scripts/generate-attestation-fixtures.ts && tsx --conditions=atcn-source packages/sdk-ts/scripts/generate-trace-fixtures.ts && tsx --conditions=atcn-source examples/local-runner/scripts/generate-package-vectors.ts",
    "gen:reconciliation": "tsx --conditions=atcn-source examples/local-runner/scripts/reconciliation.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
