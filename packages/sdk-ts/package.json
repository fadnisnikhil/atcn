{
  "name": "@atcn/sdk",
  "version": "1.5.1",
  "description": "TypeScript SDK for ATCN, a cost record for AI agent jobs that anyone can verify: record tasks and charges, sign events, verify closures offline",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadnisnikhil/atcn.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/fadnisnikhil/atcn/tree/main/packages/sdk-ts#readme",
  "bugs": {
    "url": "https://github.com/fadnisnikhil/atcn/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "atcn": "bin/atcn.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "atcn-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@atcn/core": "1.5.1",
    "@atcn/schema": "1.5.1",
    "@atcn/subledger": "1.5.1",
    "@atcn/usage": "1.5.1",
    "zod": "^4.1.0"
  }
}
