{
  "$id": "https://schemas.atcn.dev/1.5/subledger-allocation-input.json",
  "title": "subledger-allocation-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lines": {
      "default": null,
      "anyOf": [
        {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "task",
                      "delegation",
                      "cost_center",
                      "unallocated"
                    ]
                  },
                  "id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "id"
                ]
              },
              "amount_minor": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "target",
              "amount_minor"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "rule": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rule_id": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "rule_id",
            "version"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "reason"
  ]
}
