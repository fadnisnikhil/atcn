{
  "$id": "https://schemas.atcn.dev/1.5/subledger-delegation-input.json",
  "title": "subledger-delegation-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "parent_delegation_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "provider_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "provider_name_stated": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_own_id": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "external_ref": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_job_ref": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_ref": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "shared_description": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "quoted_max_minor": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "quote_basis": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "quote_valid_until": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "accepted_amount_minor": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "terms_digest": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_delivery": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "downstream_visibility": {
      "default": "unknown",
      "type": "string",
      "enum": [
        "unknown",
        "disclosed",
        "none"
      ]
    },
    "retrospective": {
      "default": false,
      "type": "boolean"
    },
    "execution": {
      "type": "object",
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "protocol": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "a2a"
            },
            "task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "context_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "name",
            "task_id"
          ]
        },
        "agent": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "agent_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "card_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "model": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "provider",
                "name",
                "version"
              ]
            },
            "additional_models": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "provider",
                  "name",
                  "version"
                ]
              }
            },
            "config_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "agent_id",
            "agent_version"
          ]
        },
        "skill": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+$"
            },
            "skill_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "agent_card_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "namespace",
            "skill_id"
          ]
        }
      },
      "required": [
        "execution_id",
        "agent"
      ]
    },
    "pricing": {
      "type": "object",
      "properties": {
        "rates": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "meter": {
                "type": "string",
                "enum": [
                  "input_tokens",
                  "output_tokens",
                  "cache_read_input_tokens",
                  "model_call",
                  "tool_call",
                  "a2a_call"
                ]
              },
              "model": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "provider",
                  "name"
                ],
                "additionalProperties": false
              },
              "tool_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "price_numerator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "price_denominator": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "meter",
              "price_numerator",
              "price_denominator"
            ],
            "additionalProperties": false
          }
        },
        "fixed_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tolerance_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "rates",
        "tolerance_bps"
      ],
      "additionalProperties": false
    },
    "refund_terms": {
      "type": "object",
      "properties": {
        "on_failure": {
          "type": "string",
          "enum": [
            "refund",
            "dispute"
          ]
        },
        "on_timeout": {
          "type": "string",
          "enum": [
            "refund",
            "dispute"
          ]
        },
        "after_settlement": {
          "type": "object",
          "properties": {
            "cap_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "window_seconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 31536000
            }
          },
          "required": [
            "cap_minor",
            "window_seconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "on_failure",
        "on_timeout",
        "after_settlement"
      ],
      "additionalProperties": false
    },
    "witness_policy": {
      "type": "object",
      "properties": {
        "min_independent_witnesses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "witness_provider_ids": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independence": {
          "type": "string",
          "const": "distinct_verified_domain"
        }
      },
      "required": [
        "min_independent_witnesses",
        "independence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "currency"
  ]
}
