              "type": {
                "type": "string",
                "enum": [
                  "quote",
                  "invoice",
                  "charge",
                  "payment_reported",
                  "refund",
                  "reversal",
                  "fee",
                  "credit",
                  "adjustment",
                  "fx_rate",
                  "estimate",
                  "hold"
                ]
              },
              "source": {
                "type": "string"
              },
              "source_event_id": {
                "type": "string"
              },
              "provider_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider_reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "amount_minor": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "event_date": {
                "type": "string",
                "minLength": 1
              },
              "imported_at": {
                "type": "string",
                "minLength": 1
              },
              "provider_status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "normalized_status": {
                "type": "string",
                "enum": [
                  "quoted",
                  "issued",
                  "pending",
                  "reported_paid",
                  "pending_finality",
                  "failed",
                  "refunded",
                  "reversed",
                  "void",
                  "unknown"
                ]
              },
              "evidence": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "uri": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "^(https:\\/\\/|urn:|s3:\\/\\/|gs:\\/\\/)"
                      },
                      "digest": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "evidence_type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "uri",
                      "digest",
                      "evidence_type"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "retrospective": {
                "type": "boolean"
              },
              "payer": {
                "type": "string",
                "enum": [
                  "buyer",
                  "provider",
                  "other"
                ]
              },
              "included_in_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reverses_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "settles_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "skill": {
                "type": "object",
                "properties": {
                  "namespace": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.-]+$"
                  },
                  "skill_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "agent_card_url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "namespace",
                  "skill_id"
                ]
              },
              "expectation": {
                "type": "object",
                "properties": {
                  "issued_by": {
                    "type": "string",
                    "enum": [
                      "agent",
                      "gateway",
                      "operator"
                    ]
                  },
                  "source_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "basis": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "expires_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "supersedes": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 200
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "hold_status": {
                    "type": "string",
                    "enum": [
                      "open",
                      "captured",
                      "released",
                      "expired"
                    ]
                  },
                  "signer": {
                    "type": "object",
                    "properties": {
                      "provider_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "binding_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "key_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "provider_id",
                      "binding_id",
                      "key_id",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "issued_by",
                  "source_ref",
                  "basis",
                  "expires_at",
                  "supersedes"
                ],
                "additionalProperties": false
              },
              "rail_attestation": {
                "type": "object",
                "properties": {
                  "scheme": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "record": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "scheme",
                  "record"
                ],
                "additionalProperties": false
              },
              "allocation_version": {
