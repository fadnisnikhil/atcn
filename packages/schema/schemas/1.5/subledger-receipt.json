{
  "$id": "https://schemas.atcn.dev/1.5/subledger-receipt.json",
  "title": "subledger-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "document_type": {
          "type": "string",
          "const": "atcn.subledger.receipt"
        },
        "schema_version": {
          "type": "string",
          "enum": [
            "1.2",
            "1.3",
            "1.4",
            "1.5"
          ]
        },
        "receipt_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "previous_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_receipt_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issued_at": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "type": "object",
          "properties": {
            "operator_id": {
              "type": "string"
            },
            "operator_name": {
              "type": "string"
            },
            "signed_by": {
              "type": "string",
              "enum": [
                "atcn-hosted-service",
                "atcn-local-runner"
              ]
            }
          },
          "required": [
            "operator_id",
            "operator_name",
            "signed_by"
          ]
        },
        "delegation": {
          "type": "object",
          "properties": {
            "delegation_id": {
              "type": "string"
            },
            "root_task_id": {
              "type": "string"
            },
            "external_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_job_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "shared_description": {
              "type": [
                "string",
                "null"
              ]
            },
            "terms_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "quoted_max_minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "quote_basis": {
              "type": [
                "string",
                "null"
              ]
            },
            "accepted_amount_minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "expected_delivery": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "retrospective": {
              "type": "boolean"
            },
            "downstream_visibility": {
              "type": "string",
              "enum": [
                "unknown",
                "disclosed",
                "none"
              ]
            },
            "execution": {
              "type": "object",
              "properties": {
                "execution_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "protocol": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "const": "a2a"
                    },
                    "task_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "context_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "name",
                    "task_id"
                  ]
                },
                "agent": {
                  "type": "object",
                  "properties": {
                    "agent_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "agent_version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "card_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "model": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        }
                      },
                      "required": [
                        "provider",
                        "name",
                        "version"
                      ]
                    },
                    "additional_models": {
                      "minItems": 1,
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "provider": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          }
                        },
                        "required": [
                          "provider",
                          "name",
                          "version"
                        ]
                      }
                    },
                    "config_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "agent_id",
                    "agent_version"
                  ]
                },
                "skill": {
                  "type": "object",
                  "properties": {
                    "namespace": {
                      "type": "string",
                      "pattern": "^[a-z0-9_.-]+$"
                    },
                    "skill_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "agent_card_url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "namespace",
                    "skill_id"
                  ]
                }
              },
              "required": [
                "execution_id",
                "agent"
              ]
            },
            "pricing": {
              "type": "object",
              "properties": {
                "rates": {
                  "minItems": 1,
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "meter": {
                        "type": "string",
                        "enum": [
                          "input_tokens",
                          "output_tokens",
                          "cache_read_input_tokens",
                          "model_call",
                          "tool_call",
                          "a2a_call"
                        ]
                      },
                      "model": {
                        "type": "object",
                        "properties": {
                          "provider": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          }
                        },
                        "required": [
                          "provider",
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      "tool_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "price_numerator": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "price_denominator": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "meter",
                      "price_numerator",
                      "price_denominator"
                    ],
                    "additionalProperties": false
                  }
                },
                "fixed_minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "tolerance_bps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "required": [
                "rates",
                "tolerance_bps"
              ],
              "additionalProperties": false
            },
            "refund_terms": {
              "type": "object",
              "properties": {
                "on_failure": {
                  "type": "string",
                  "enum": [
                    "refund",
                    "dispute"
                  ]
                },
                "on_timeout": {
                  "type": "string",
                  "enum": [
                    "refund",
                    "dispute"
                  ]
                },
                "after_settlement": {
                  "type": "object",
                  "properties": {
                    "cap_minor": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "window_seconds": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 31536000
                    }
                  },
                  "required": [
                    "cap_minor",
                    "window_seconds"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "on_failure",
                "on_timeout",
                "after_settlement"
              ],
              "additionalProperties": false
            },
            "witness_policy": {
              "type": "object",
              "properties": {
                "min_independent_witnesses": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "witness_provider_ids": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "independence": {
                  "type": "string",
                  "const": "distinct_verified_domain"
                }
              },
              "required": [
                "min_independent_witnesses",
                "independence"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "delegation_id",
            "root_task_id",
            "external_ref",
            "provider_job_ref",
            "shared_description",
            "terms_digest",
            "currency",
            "quoted_max_minor",
            "quote_basis",
            "accepted_amount_minor",
            "expected_delivery",
            "retrospective",
            "downstream_visibility"
          ]
        },
        "provider": {
          "type": "object",
          "properties": {
            "provider_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name_stated": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_own_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "identity_binding": {
              "type": "string",
              "enum": [
                "key_bound",
                "not_bound"
              ]
            }
          },
          "required": [
            "provider_id",
            "name_stated",
            "provider_own_id",
            "identity_binding"
          ]
        },
        "delivery_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "acceptance",
                  "completion",
                  "partial_completion",
                  "cancellation",
                  "provider_failure",
                  "terms_update",
                  "correction"
                ]
              },
              "asserted_by": {
                "type": "string",
                "enum": [
                  "buyer",
                  "provider",
                  "clearing_policy",
                  "dispute_reviewer",
                  "clearing_network"
                ]
              },
              "assurance": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "issuer_signed",
                    "buyer_recorded",
                    "network_recorded",
                    "recipient_viewed",
                    "link_authenticated_response",
                    "provider_identity_bound",
                    "provider_key_signed",
                    "contested",
                    "superseded",
                    "expired",
                    "revoked",
                    "gateway_signed",
                    "rail_attested"
                  ]
                }
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "^(https:\\/\\/|urn:|s3:\\/\\/|gs:\\/\\/)"
                    },
                    "digest": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "evidence_type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "uri",
                    "digest",
                    "evidence_type"
                  ]
                }
              },
              "supersedes_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retrospective": {
                "type": "boolean"
              },
              "occurred_at": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1
              },
              "usage": {
                "type": "object",
                "properties": {
                  "trace_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "summary": {
                    "type": "object",
                    "properties": {
                      "models": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "calls": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "input_tokens": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "output_tokens": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "cache_read_input_tokens": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "provider",
                            "name",
                            "calls",
                            "input_tokens",
                            "output_tokens",
                            "cache_read_input_tokens"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "tools": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "calls": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "name",
                            "calls"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "a2a_calls": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "models",
                      "tools",
                      "a2a_calls"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "trace_digest",
                  "summary"
                ],
                "additionalProperties": false
              },
              "signer": {
                "type": "object",
                "properties": {
                  "provider_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "binding_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "provider_id",
                  "binding_id",
                  "key_id",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "event_id",
              "type",
              "asserted_by",
              "assurance",
              "note",
              "evidence",
              "supersedes_event_id",
              "reason",
              "retrospective",
              "occurred_at",
              "recorded_at"
            ]
          }
        },
        "financial_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "financial_event_id": {
                "type": "string"
