{
  "$id": "https://schemas.atcn.dev/1.5/subledger-delegation-event-input.json",
  "title": "subledger-delegation-event-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "acceptance",
        "completion",
        "partial_completion",
        "cancellation",
        "provider_failure",
        "terms_update",
        "correction"
      ]
    },
    "asserted_by": {
      "default": "buyer",
      "type": "string",
      "enum": [
        "buyer",
        "provider"
      ]
    },
    "note": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(https:\\/\\/|urn:|s3:\\/\\/|gs:\\/\\/)"
          },
          "digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "uri",
          "digest",
          "evidence_type"
        ]
      }
    },
    "terms": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "quoted_max_minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "accepted_amount_minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "quote_basis": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "quote_valid_until": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "terms_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expected_delivery": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "downstream_visibility": {
              "type": "string",
              "enum": [
                "unknown",
                "disclosed",
                "none"
              ]
            },
            "pricing": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "rates": {
                      "minItems": 1,
                      "maxItems": 200,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "meter": {
                            "type": "string",
                            "enum": [
                              "input_tokens",
                              "output_tokens",
                              "cache_read_input_tokens",
                              "model_call",
                              "tool_call",
                              "a2a_call"
                            ]
                          },
                          "model": {
                            "type": "object",
                            "properties": {
                              "provider": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100
                              },
                              "name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200
                              }
                            },
                            "required": [
                              "provider",
                              "name"
                            ],
                            "additionalProperties": false
                          },
                          "tool_name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "price_numerator": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "price_denominator": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "meter",
                          "price_numerator",
                          "price_denominator"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "fixed_minor": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "tolerance_bps": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000
                    }
                  },
                  "required": [
                    "rates",
                    "tolerance_bps"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "refund_terms": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "on_failure": {
                      "type": "string",
                      "enum": [
                        "refund",
                        "dispute"
                      ]
                    },
                    "on_timeout": {
                      "type": "string",
                      "enum": [
                        "refund",
                        "dispute"
                      ]
                    },
                    "after_settlement": {
                      "type": "object",
                      "properties": {
                        "cap_minor": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "window_seconds": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 31536000
                        }
                      },
                      "required": [
                        "cap_minor",
                        "window_seconds"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "on_failure",
                    "on_timeout",
                    "after_settlement"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "witness_policy": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "min_independent_witnesses": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "witness_provider_ids": {
                      "minItems": 1,
                      "maxItems": 20,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "independence": {
                      "type": "string",
                      "const": "distinct_verified_domain"
                    }
                  },
                  "required": [
                    "min_independent_witnesses",
                    "independence"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes_event_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "retrospective": {
      "default": false,
      "type": "boolean"
    },
    "occurred_at": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "trace_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "summary": {
          "type": "object",
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "calls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "input_tokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "output_tokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cache_read_input_tokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "provider",
                  "name",
                  "calls",
                  "input_tokens",
                  "output_tokens",
                  "cache_read_input_tokens"
                ],
                "additionalProperties": false
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "calls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "name",
                  "calls"
                ],
                "additionalProperties": false
              }
            },
            "a2a_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "models",
            "tools",
            "a2a_calls"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "trace_digest",
        "summary"
      ],
      "additionalProperties": false
    },
    "signer": {
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider_id",
        "binding_id",
        "key_id",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type"
  ]
}
