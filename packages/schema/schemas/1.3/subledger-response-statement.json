{
  "$id": "https://schemas.atcn.dev/1.3/subledger-response-statement.json",
  "title": "subledger-response-statement",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "document_type": {
      "type": "string",
      "const": "atcn.subledger.receipt_response"
    },
    "receipt_id": {
      "type": "string"
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receipt_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "issuer_operator_id": {
      "type": "string"
    },
    "response_type": {
      "type": "string",
      "enum": [
        "acknowledge_view",
        "acknowledge_delivery",
        "submit_evidence",
        "propose_correction",
        "signed_attestation"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "delivery.status",
          "delivery.evidence",
          "scope.terms_digest",
          "financial.amounts",
          "financial.status"
        ]
      }
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(https:\\/\\/|urn:|s3:\\/\\/|gs:\\/\\/)"
          },
          "digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "uri",
          "digest",
          "evidence_type"
        ]
      }
    },
    "corrections": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "delivery.status",
              "delivery.evidence",
              "scope.terms_digest",
              "financial.amounts",
              "financial.status"
            ]
          },
          "proposed_value": {
            "type": "string",
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "field",
          "proposed_value",
          "reason"
        ]
      }
    }
  },
  "required": [
    "document_type",
    "receipt_id",
    "receipt_digest",
    "receipt_revision",
    "issuer_operator_id",
    "response_type",
    "fields",
    "note",
    "evidence",
    "corrections"
  ]
}
