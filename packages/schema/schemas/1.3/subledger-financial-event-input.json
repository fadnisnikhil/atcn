{
  "$id": "https://schemas.atcn.dev/1.3/subledger-financial-event-input.json",
  "title": "subledger-financial-event-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "quote",
        "invoice",
        "charge",
        "payment_reported",
        "refund",
        "reversal",
        "fee",
        "credit",
        "adjustment",
        "fx_rate"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "provider_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "provider_reference": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "amount_minor": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "event_date": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "provider_status": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "normalized_status": {
      "default": "unknown",
      "type": "string",
      "enum": [
        "quoted",
        "issued",
        "pending",
        "reported_paid",
        "failed",
        "refunded",
        "reversed",
        "void",
        "unknown"
      ]
    },
    "evidence": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^(https:\\/\\/|urn:|s3:\\/\\/|gs:\\/\\/)"
            },
            "digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "uri",
            "digest",
            "evidence_type"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "retrospective": {
      "default": false,
      "type": "boolean"
    },
    "payer": {
      "default": "buyer",
      "type": "string",
      "enum": [
        "buyer",
        "provider",
        "other"
      ]
    },
    "liability_owner": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "economic_event_id": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "included_in_event_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "reverses_event_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "settles_event_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "fx": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "base_currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "quote_currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "rate_numerator": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "rate_denominator": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "base_currency",
            "quote_currency",
            "rate_numerator",
            "rate_denominator"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "match": {
      "default": {
        "task_id": null,
        "delegation_id": null,
        "task_external_ref": null,
        "delegation_external_ref": null,
        "provider_job_ref": null
      },
      "type": "object",
      "properties": {
        "task_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "delegation_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "task_external_ref": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "delegation_external_ref": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "provider_job_ref": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "type",
    "source",
    "source_event_id",
    "amount_minor",
    "currency",
    "event_date"
  ]
}
