{
  "$id": "https://schemas.atcn.dev/1.3/subledger-receipt.json",
  "title": "subledger-receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "document_type": {
          "type": "string",
          "const": "atcn.subledger.receipt"
        },
        "schema_version": {
          "type": "string",
          "enum": [
            "1.2",
            "1.3"
          ]
        },
        "receipt_id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "previous_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_receipt_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issued_at": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "type": "object",
          "properties": {
            "operator_id": {
              "type": "string"
            },
            "operator_name": {
              "type": "string"
            },
            "signed_by": {
              "type": "string",
              "enum": [
                "atcn-hosted-service",
                "atcn-local-runner"
              ]
            }
          },
          "required": [
            "operator_id",
            "operator_name",
            "signed_by"
          ]
        },
        "delegation": {
          "type": "object",
          "properties": {
            "delegation_id": {
              "type": "string"
            },
            "root_task_id": {
              "type": "string"
            },
            "external_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_job_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "shared_description": {
              "type": [
                "string",
                "null"
              ]
            },
            "terms_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "quoted_max_minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "quote_basis": {
              "type": [
                "string",
                "null"
              ]
            },
            "accepted_amount_minor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "expected_delivery": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "retrospective": {
              "type": "boolean"
            },
            "downstream_visibility": {
              "type": "string",
              "enum": [
                "unknown",
                "disclosed",
                "none"
              ]
            }
          },
          "required": [
            "delegation_id",
            "root_task_id",
            "external_ref",
            "provider_job_ref",
            "shared_description",
            "terms_digest",
            "currency",
            "quoted_max_minor",
            "quote_basis",
            "accepted_amount_minor",
            "expected_delivery",
            "retrospective",
            "downstream_visibility"
          ]
        },
        "provider": {
          "type": "object",
          "properties": {
            "provider_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "name_stated": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_own_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "identity_binding": {
              "type": "string",
              "enum": [
                "key_bound",
                "not_bound"
              ]
            }
          },
          "required": [
            "provider_id",
            "name_stated",
            "provider_own_id",
            "identity_binding"
          ]
        },
        "delivery_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "acceptance",
                  "completion",
                  "partial_completion",
                  "cancellation",
                  "provider_failure",
                  "terms_update",
                  "correction"
                ]
              },
              "asserted_by": {
                "type": "string",
                "enum": [
                  "buyer",
                  "provider",
                  "clearing_policy",
                  "dispute_reviewer",
                  "clearing_network"
                ]
              },
              "assurance": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "issuer_signed",
                    "buyer_recorded",
                    "network_recorded",
                    "recipient_viewed",
                    "link_authenticated_response",
                    "provider_identity_bound",
                    "provider_key_signed",
                    "contested",
                    "superseded"
                  ]
                }
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "^(https:\\/\\/|urn:|s3:\\/\\/|gs:\\/\\/)"
                    },
                    "digest": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "evidence_type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "uri",
                    "digest",
                    "evidence_type"
                  ]
                }
              },
              "supersedes_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retrospective": {
                "type": "boolean"
              },
              "occurred_at": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "event_id",
              "type",
              "asserted_by",
              "assurance",
              "note",
              "evidence",
              "supersedes_event_id",
              "reason",
              "retrospective",
              "occurred_at",
              "recorded_at"
            ]
          }
        },
        "financial_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "financial_event_id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "quote",
                  "invoice",
                  "charge",
                  "payment_reported",
                  "refund",
                  "reversal",
                  "fee",
                  "credit",
                  "adjustment",
                  "fx_rate"
                ]
              },
              "source": {
                "type": "string"
              },
              "source_event_id": {
                "type": "string"
              },
              "provider_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provider_reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "amount_minor": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "event_date": {
                "type": "string",
                "minLength": 1
              },
              "imported_at": {
                "type": "string",
                "minLength": 1
              },
              "provider_status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "normalized_status": {
                "type": "string",
                "enum": [
                  "quoted",
                  "issued",
                  "pending",
                  "reported_paid",
                  "failed",
                  "refunded",
                  "reversed",
                  "void",
                  "unknown"
                ]
              },
              "evidence": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "uri": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048,
                        "pattern": "^(https:\\/\\/|urn:|s3:\\/\\/|gs:\\/\\/)"
                      },
                      "digest": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "evidence_type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "uri",
                      "digest",
                      "evidence_type"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "retrospective": {
                "type": "boolean"
              },
              "payer": {
                "type": "string",
                "enum": [
                  "buyer",
                  "provider",
                  "other"
                ]
              },
              "included_in_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reverses_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "settles_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "allocation_version": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "financial_event_id",
              "type",
              "source",
              "source_event_id",
              "provider_id",
              "provider_reference",
              "amount_minor",
              "currency",
              "event_date",
              "imported_at",
              "provider_status",
              "normalized_status",
              "evidence",
              "retrospective",
              "payer",
              "included_in_event_id",
              "reverses_event_id",
              "settles_event_id",
              "reason",
              "allocation_version"
            ]
          }
        },
        "totals": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "quoted": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "accepted": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "invoiced": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "charged": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "fees": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "adjustments": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "refunded": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "credits": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "reported_paid": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "net_cost": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "unresolved": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "downstream_reported": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "quoted",
              "accepted",
              "invoiced",
              "charged",
              "fees",
              "adjustments",
              "refunded",
              "credits",
              "reported_paid",
              "net_cost",
              "unresolved",
              "downstream_reported"
            ]
          }
        },
        "field_status": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "delivery.status",
              "delivery.evidence",
              "scope.terms_digest",
              "financial.amounts",
              "financial.status"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "missing",
              "imported",
              "buyer_asserted",
              "provider_reported",
              "contested"
            ]
          },
          "required": [
            "delivery.status",
            "delivery.evidence",
            "scope.terms_digest",
            "financial.amounts",
            "financial.status"
          ]
        },
        "unverified_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "delivery.status",
              "delivery.evidence",
              "scope.terms_digest",
              "financial.amounts",
              "financial.status"
            ]
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "response_id": {
                "type": "string"
              },
              "receipt_revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "delivery.status",
                    "delivery.evidence",
                    "scope.terms_digest",
                    "financial.amounts",
                    "financial.status"
                  ]
                }
              },
              "decision": {
                "type": "string",
                "enum": [
                  "accepted",
                  "rejected",
                  "open"
                ]
              }
            },
            "required": [
              "response_id",
              "receipt_revision",
              "fields",
              "decision"
            ]
          }
        },
        "lineage": {
          "type": "object",
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "capture_gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "gap_id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  },
                  "reported_at": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "gap_id",
                  "kind",
                  "detail",
                  "reported_at"
                ]
              }
            }
          },
          "required": [
            "complete",
            "capture_gaps"
          ]
        }
      },
      "required": [
        "document_type",
        "schema_version",
        "receipt_id",
        "revision",
        "previous_receipt_id",
        "previous_receipt_digest",
        "issued_at",
        "expires_at",
        "issuer",
        "delegation",
        "provider",
        "delivery_claims",
        "financial_events",
        "totals",
        "field_status",
        "unverified_fields",
        "corrections",
        "lineage"
      ]
    },
    "signature": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string"
        },
        "key_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "key_version",
        "algorithm",
        "value"
      ]
    },
    "operator_signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key_id": {
            "type": "string"
          },
          "algorithm": {
            "type": "string",
            "const": "Ed25519"
          },
          "value": {
            "type": "string"
          },
          "signed_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key_id",
          "algorithm",
          "value",
          "signed_at"
        ]
      }
    }
  },
  "required": [
    "payload",
    "signature"
  ]
}
