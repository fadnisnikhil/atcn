{
  "$id": "https://schemas.atcn.dev/1.2/clearing-decision.json",
  "title": "clearing-decision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "obligation_id": {
      "type": "string",
      "pattern": "^obl_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "terms_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "terms_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "policy_digest"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "accepted",
        "partially_accepted",
        "rejected",
        "insufficient_evidence",
        "disputed",
        "cancelled",
        "expired"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "accepted_amount_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rejected_amount_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "disputed_amount_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pending_amount_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deliverable_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "deliverable_id": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outcome": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected",
              "insufficient_evidence",
              "disputed"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "missing_evidence",
                    "invalid_evidence",
                    "failed_criteria",
                    "verifier_unavailable",
                    "probabilistic_review_required",
                    "partial_not_permitted",
                    "passed",
                    "dispute_amended",
                    "dispute_upheld",
                    "failure_terms_dispute",
                    "conflicting_attestations",
                    "witness_quorum_not_met"
                  ]
                },
                "check_id": {
                  "type": "string"
                },
                "evidence_type": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "code"
              ]
            }
          }
        },
        "required": [
          "deliverable_id",
          "amount_minor",
          "outcome",
          "reasons"
        ]
      }
    },
    "input_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "evidence_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "verifier_output_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "decision_maker": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "automated",
            "human"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "decision_id": {
      "type": "string",
      "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "decision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "supersedes_decision_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_cutoff_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "obligation_id",
    "terms_version",
    "terms_digest",
    "policy",
    "outcome",
    "currency",
    "accepted_amount_minor",
    "rejected_amount_minor",
    "disputed_amount_minor",
    "pending_amount_minor",
    "deliverable_outcomes",
    "input_event_ids",
    "evidence_digests",
    "verifier_output_digests",
    "decision_maker",
    "decision_id",
    "decision_digest",
    "decided_at",
    "supersedes_decision_id",
    "input_cutoff_sequence"
  ]
}
