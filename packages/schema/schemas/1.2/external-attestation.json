{
  "$id": "https://schemas.atcn.dev/1.2/external-attestation.json",
  "title": "external-attestation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "verifier",
            "witness"
          ]
        },
        "obligation_id": {
          "type": "string",
          "pattern": "^obl_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "deliverable_id": {
          "type": "string"
        },
        "check_id": {
          "type": "string"
        },
        "verifier_id": {
          "type": "string",
          "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "probabilistic": {
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "confidence_bps": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "name",
                "version",
                "confidence_bps"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "execution": {
          "type": "object",
          "properties": {
            "execution_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "execution_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "execution_id",
            "execution_digest"
          ]
        },
        "evidence_digests": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "refs": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "relation": {
                "type": "string",
                "enum": [
                  "revokes",
                  "disputes"
                ]
              },
              "attestation_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "relation",
              "attestation_digest",
              "reason"
            ]
          }
        }
      },
      "required": [
        "obligation_id",
        "deliverable_id",
        "check_id",
        "verifier_id",
        "status",
        "probabilistic",
        "model",
        "summary"
      ]
    },
    "signature": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^(key_[0-9A-HJKMNP-TV-Z]{26}|key_atcn_service)$"
        },
        "key_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key_id",
        "key_version",
        "algorithm",
        "value"
      ]
    }
  },
  "required": [
    "payload",
    "signature"
  ]
}
