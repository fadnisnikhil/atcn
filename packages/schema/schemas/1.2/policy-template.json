{
  "$id": "https://schemas.atcn.dev/1.2/policy-template.json",
  "title": "policy-template",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "evidence_admissibility": {
      "type": "object",
      "properties": {
        "allowed_producers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "issuer",
              "counterparty",
              "verifier",
              "witness"
            ]
          }
        },
        "require_digest_match": {
          "type": "boolean"
        }
      },
      "required": [
        "allowed_producers",
        "require_digest_match"
      ]
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "verifier": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "verifier_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "evidence_type": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "config": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "check_id",
          "verifier",
          "verifier_version",
          "evidence_type",
          "config"
        ]
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "partial_acceptance": {
          "type": "boolean"
        },
        "failed_portion_outcome": {
          "type": "string",
          "enum": [
            "rejected",
            "disputed"
          ]
        }
      },
      "required": [
        "partial_acceptance",
        "failed_portion_outcome"
      ]
    },
    "verifier_unavailable_outcome": {
      "type": "string",
      "enum": [
        "insufficient_evidence",
        "disputed"
      ]
    },
    "probabilistic_routing": {
      "type": "string",
      "enum": [
        "evidence_only",
        "human_review"
      ]
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "evaluation_window_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "evaluation_window_seconds"
      ]
    },
    "dispute": {
      "type": "object",
      "properties": {
        "window_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "review_window_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "default_outcome": {
          "type": "string",
          "enum": [
            "uphold"
          ]
        }
      },
      "required": [
        "window_seconds",
        "review_window_seconds",
        "default_outcome"
      ]
    },
    "allocation": {
      "type": "object",
      "properties": {
        "platform_fee_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "platform_fee_bps"
      ]
    },
    "rounding": {
      "type": "string",
      "const": "largest_remainder"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "task_type",
    "description",
    "evidence_admissibility",
    "required_evidence",
    "checks",
    "thresholds",
    "verifier_unavailable_outcome",
    "probabilistic_routing",
    "timeouts",
    "dispute",
    "allocation",
    "rounding"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
