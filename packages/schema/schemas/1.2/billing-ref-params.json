{
  "$id": "https://schemas.atcn.dev/1.2/billing-ref-params.json",
  "title": "billing-ref-params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "billing_ref": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "task_id",
            "context_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "metadata_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "metadata_key"
          ],
          "additionalProperties": false
        }
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "pricing": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "skill_id",
          "unit",
          "amount_minor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "billing_ref"
  ],
  "additionalProperties": false
}
