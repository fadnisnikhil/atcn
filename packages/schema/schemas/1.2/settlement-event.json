{
  "$id": "https://schemas.atcn.dev/1.2/settlement-event.json",
  "title": "settlement-event",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "settlement_event_id": {
      "type": "string"
    },
    "instruction_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "manual",
        "sandbox",
        "stripe"
      ]
    },
    "provider_event_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_reference": {
      "type": "string",
      "minLength": 1
    },
    "provider_status": {
      "type": "string",
      "minLength": 1
    },
    "normalized_status": {
      "type": "string",
      "enum": [
        "submitted",
        "processing",
        "pending_finality",
        "settled",
        "failed",
        "returned",
        "refunded",
        "unknown"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "amount_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "raw_json": {
      "type": "string"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "settlement_event_id",
    "instruction_id",
    "provider",
    "provider_event_id",
    "provider_reference",
    "provider_status",
    "normalized_status",
    "currency",
    "amount_minor",
    "raw_json",
    "reported_at"
  ]
}
