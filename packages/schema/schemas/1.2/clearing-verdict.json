{
  "$id": "https://schemas.atcn.dev/1.2/clearing-verdict.json",
  "title": "clearing-verdict",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "document_type": {
          "type": "string",
          "const": "atcn.clearing.verdict"
        },
        "verdict_version": {
          "type": "string",
          "const": "1.0"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "obligation_id": {
          "type": "string",
          "pattern": "^obl_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "decision": {
          "type": "object",
          "properties": {
            "decision_id": {
              "type": "string",
              "pattern": "^dec_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "decision_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "decided_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "accepted",
                "partially_accepted",
                "rejected",
                "insufficient_evidence",
                "disputed",
                "cancelled",
                "expired"
              ]
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "accepted_amount_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rejected_amount_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "disputed_amount_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pending_amount_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "decision_id",
            "decision_digest",
            "decided_at",
            "outcome",
            "currency",
            "accepted_amount_minor",
            "rejected_amount_minor",
            "disputed_amount_minor",
            "pending_amount_minor"
          ],
          "additionalProperties": false
        },
        "final": {
          "type": "boolean"
        },
        "escrow": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "rail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "escrow_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "rail",
                "escrow_ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "package_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "stance": {
          "type": "string",
          "const": "record_only"
        }
      },
      "required": [
        "document_type",
        "verdict_version",
        "issued_at",
        "obligation_id",
        "decision",
        "final",
        "escrow",
        "package_digest",
        "stance"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^(key_[0-9A-HJKMNP-TV-Z]{26}|key_atcn_service)$"
        },
        "key_version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key_id",
        "key_version",
        "algorithm",
        "value"
      ]
    }
  },
  "required": [
    "payload",
    "signature"
  ]
}
