{
  "$id": "https://schemas.atcn.dev/1.1/obligation-terms.json",
  "title": "obligation-terms",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "obligation_id": {
      "type": "string",
      "pattern": "^obl_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "terms_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "parent_obligation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^obl_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "principal_id": {
      "type": "string",
      "pattern": "^prn_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "payer_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^prn_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "string",
          "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "issuer_agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "counterparty_agent_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payee_selection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "open_offer"
            },
            "allowed_platform_ids": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^plt_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            }
          },
          "required": [
            "type",
            "allowed_platform_ids"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "task_type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string"
        }
      },
      "required": [
        "task_type",
        "description"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "max_amount_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deliverables": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "deliverable_id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "description": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "required_checks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "deliverable_id",
          "description",
          "amount_minor",
          "required_checks"
        ]
      }
    },
    "acceptance_policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "policy_digest"
      ]
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "offer_expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "allow_subdelegation": {
      "type": "boolean"
    },
    "subdelegation_limits": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "max_depth": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "max_total_minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "allowed_policy_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "max_depth",
            "max_total_minor",
            "allowed_policy_ids"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "dispute_reviewer_id": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            {
              "type": "string",
              "pattern": "^prn_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "verifier_agent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^agt_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "skill": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "skill_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "agent_card_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "namespace",
        "skill_id"
      ]
    }
  },
  "required": [
    "schema_version",
    "obligation_id",
    "terms_version",
    "parent_obligation_id",
    "principal_id",
    "payer_id",
    "issuer_agent_id",
    "counterparty_agent_id",
    "payee_selection",
    "scope",
    "currency",
    "max_amount_minor",
    "deliverables",
    "acceptance_policy",
    "deadline",
    "offer_expires_at",
    "allow_subdelegation",
    "subdelegation_limits",
    "dispute_reviewer_id",
    "verifier_agent_ids",
    "issued_at"
  ]
}
