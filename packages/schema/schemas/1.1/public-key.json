{
  "$id": "https://schemas.atcn.dev/1.1/public-key.json",
  "title": "public-key",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key_id": {
      "type": "string",
      "pattern": "^(key_[0-9A-HJKMNP-TV-Z]{26}|key_atcn_service)$"
    },
    "key_version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "actor_id": {
      "type": "string",
      "pattern": "^((prn|agt|plt)_[0-9A-HJKMNP-TV-Z]{26}|svc_atcn)$"
    },
    "algorithm": {
      "type": "string",
      "const": "Ed25519"
    },
    "public_key": {
      "type": "string"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "key_id",
    "key_version",
    "actor_id",
    "algorithm",
    "public_key",
    "valid_from",
    "revoked_at"
  ]
}
