{
  "name": "@atcn/local-runner",
  "version": "1.3.1",
  "description": "Run an ATCN job on your machine: capture the work, reconcile its costs, and verify the signed result offline. No account or API needed.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadnisnikhil/atcn.git",
    "directory": "examples/local-runner"
  },
  "homepage": "https://github.com/fadnisnikhil/atcn/tree/main/examples/local-runner#readme",
  "bugs": {
    "url": "https://github.com/fadnisnikhil/atcn/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "atcn-local": "bin/atcn-local.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "atcn-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "demos"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@atcn/core": "1.3.0",
    "@atcn/schema": "1.3.0",
    "@atcn/sdk": "1.3.0",
    "@atcn/subledger": "1.3.0",
    "@atcn/usage": "1.3.0",
    "@atcn/verifiers": "1.3.0",
    "zod": "^4.1.0"
  }
}
